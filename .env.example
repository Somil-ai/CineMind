POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:change-me@db:5432/cinemind
REDIS_URL=redis://redis:6379
TMDB_API_KEY=            # the v3 "API Key" from themoviedb.org/settings/api (NOT the Read Access Token)
JWT_ACCESS_SECRET=       # openssl rand -hex 32
JWT_REFRESH_SECRET=      # openssl rand -hex 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RECO_URL=http://reco:8001
CORS_ORIGINS=http://localhost:3000
ADMIN_EMAILS=            # comma-separated; these emails get the admin role at signup
AUTH_RATE_LIMIT=10       # register/login attempts per IP per minute
NEXT_PUBLIC_API_URL=http://localhost:4000/v1   # baked into the web build
API_URL=http://localhost:4000/v1               # used by the web server for SSR (use http://api:4000/v1 in Docker)
CATALOG_PATH=data/catalog.json   # reco service loads this if it exists (created by the TMDB sync script)
